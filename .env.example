# Postgres
DATABASE_URL="postgresql://quickstart:quickstart@localhost:5433/quickstart?schema=public"

# MongoDB (chat sessions/messages)
MONGODB_URI="mongodb://localhost:27017/quickstart"

# Redis (cache, rate limits, BullMQ)
REDIS_URL="redis://localhost:6380"

# Auth
JWT_SECRET="change-me-to-a-long-random-secret"
# AES-256-GCM for BYOK API keys (min 32 chars, or 64-char hex)
ENCRYPTION_KEY="change-me-to-a-long-random-secret-at-least-32-chars"
JWT_EXPIRES_IN="7d"
COOKIE_SECURE="false"
COOKIE_SAME_SITE="lax"

# API
API_PORT=3100
API_HOST="0.0.0.0"
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"
PUBLIC_API_URL="http://localhost:3100"
WEB_APP_URL="http://localhost:3000"

# Email (team invites via Resend — optional in dev; invite URL logged when unset)
RESEND_API_KEY=""
MAIL_FROM="QuickStart AI <onboarding@resend.dev>"

# Embeddings / LLM via OpenRouter
OPENROUTER_API_KEY=""
# Optional alias — same key works if you point OPENAI_BASE_URL at OpenRouter
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://openrouter.ai/api/v1"
# Default chat model. Onboarding uses a free→paid chain in code (see packages/rag llm.ts).
LLM_MODEL="google/gemma-4-31b-it:free"
EMBEDDING_MODEL="openai/text-embedding-3-small"
EMBEDDING_DIMENSIONS=1536
OPENROUTER_SITE_URL="http://localhost:3000"
OPENROUTER_APP_NAME="QuickStart AI"

# Rate limits
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_IP=60
RATE_LIMIT_MAX_CLIENT=120
RATE_LIMIT_MAX_AUTH_IP=10
RATE_LIMIT_MAX_AUTH_EMAIL=5

# Cache
CHAT_CACHE_TTL_SECONDS=300

# Web
NEXT_PUBLIC_API_URL="http://localhost:3100"
NEXT_PUBLIC_APP_NAME="QuickStart AI"
# Set after running: pnpm seed:demo
NEXT_PUBLIC_DEMO_CLIENT_ID=""

# MCP server (ChatGPT / Claude integration via Model Context Protocol)
# Get token: POST /api/v1/auth/login with your dashboard credentials
QUICKSTART_API_URL="http://localhost:3100"
QUICKSTART_API_TOKEN=""
QUICKSTART_PROJECT_ID=""

# How long a human handoff may sit untouched before the bot resumes the
# conversation. Prevents a visitor being stranded with a silent widget when
# nobody is on shift. Default 10 minutes.
HANDOFF_TIMEOUT_MS="600000"
