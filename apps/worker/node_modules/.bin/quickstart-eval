#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*) basedir=`cygpath -w "$basedir"`;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/home/aqib/quickstart-ai/packages/eval/dist/node_modules:/home/aqib/quickstart-ai/packages/eval/node_modules:/home/aqib/quickstart-ai/packages/node_modules:/home/aqib/quickstart-ai/node_modules:/home/aqib/node_modules:/home/node_modules:/node_modules:/home/aqib/quickstart-ai/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/home/aqib/quickstart-ai/packages/eval/dist/node_modules:/home/aqib/quickstart-ai/packages/eval/node_modules:/home/aqib/quickstart-ai/packages/node_modules:/home/aqib/quickstart-ai/node_modules:/home/aqib/node_modules:/home/node_modules:/node_modules:/home/aqib/quickstart-ai/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../@quickstart-ai/eval/dist/cli.js" "$@"
else
  exec node  "$basedir/../@quickstart-ai/eval/dist/cli.js" "$@"
fi
