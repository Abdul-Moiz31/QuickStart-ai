# Postgres
DATABASE_URL="postgresql://quickstart:quickstart@localhost:5433/quickstart?schema=public"

# MongoDB (chat sessions/messages)
MONGODB_URI="mongodb://localhost:27017/quickstart"

# Redis (cache, rate limits, BullMQ)
REDIS_URL="redis://localhost:6380"

# Auth
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"
COOKIE_SECURE="false"
COOKIE_SAME_SITE="lax"

# API
API_PORT=3100
API_HOST="0.0.0.0"
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"
PUBLIC_API_URL="http://localhost:3100"

# Embeddings / LLM via OpenRouter (OpenAI-compatible)
OPENROUTER_API_KEY="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"
OPENAI_API_KEY="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"
OPENAI_BASE_URL="https://openrouter.ai/api/v1"
# Default chat model (free). Chat tries free→paid fallbacks automatically.
LLM_MODEL="google/gemma-4-26b-a4b-it:free"
LLM_MODEL_FALLBACKS="google/gemma-4-26b-a4b-it:free,openai/gpt-oss-20b:free,nvidia/nemotron-3-nano-30b-a3b:free,nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free,mistralai/mistral-nemo"
EMBEDDING_MODEL="openai/text-embedding-3-small"
EMBEDDING_DIMENSIONS=1536
OPENROUTER_SITE_URL="http://localhost:3000"
OPENROUTER_APP_NAME="QuickStart AI"

# Rate limits
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_IP=60
RATE_LIMIT_MAX_CLIENT=120

# Cache
CHAT_CACHE_TTL_SECONDS=300

# Web
NEXT_PUBLIC_API_URL="http://localhost:3100"
NEXT_PUBLIC_APP_NAME="QuickStart AI"
ENCRYPTION_KEY="change-me-to-a-long-random-secret-at-least-32-chars"
NEXT_PUBLIC_DEMO_CLIENT_ID="qs_ttw7y2rj2fjokf7v5ngz96oy"
